    "Amount" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество"
          }
        }
      }
    },
    "An expenses list details all your spending, helping you track money flow and spot patterns. It aids in making informed financial decisions." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Список расходов детализирует все ваши траты, помогая отслеживать движение денег и выявлять закономерности. Он способствует принятию обоснованных финансовых решений."
          }
        }
      }
    },
